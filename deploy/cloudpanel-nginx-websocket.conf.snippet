# Optional CloudPanel vhost extras for ShareAnything (Socket.io).
# CloudPanel reverse-proxy sites already set Upgrade headers; if live sync
# fails, paste the location block below into the site's custom nginx config
# (or ensure the generated @reverse_proxy block keeps Connection Upgrade).
#
# Proxy target: http://127.0.0.1:3020
# Domain: shareanything.yashkumarram.com

# location /socket.io/ {
#   proxy_pass http://127.0.0.1:3020;
#   proxy_http_version 1.1;
#   proxy_set_header Upgrade $http_upgrade;
#   proxy_set_header Connection "Upgrade";
#   proxy_set_header Host $host;
#   proxy_set_header X-Real-IP $remote_addr;
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_read_timeout 86400;
# }

# Uploads: files can be up to 100 MB (SHAREANYTHING_MAX_FILE_MB). Make sure the
# site's nginx allows that, or big uploads fail with 413 before reaching the app.
# In CloudPanel → Site → Vhost, inside the server { } block:
#
# client_max_body_size 110m;
# proxy_request_buffering off;   # stream uploads straight to the app
