{
  "name": "share-anything",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,socket -c cyan,magenta \"next dev\" \"tsx server/socket.ts\"",
    "dev:web": "next dev",
    "dev:socket": "tsx server/socket.ts",
    "build": "next build",
    "start": "concurrently -k -n web,socket -c cyan,magenta \"next start\" \"tsx server/socket.ts\"",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
